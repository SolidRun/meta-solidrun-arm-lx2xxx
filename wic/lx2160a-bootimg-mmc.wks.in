# short-description: Create SD-Card/eMMC image with a boot partition
# long-description:
# Create an image that can be written onto an SD card or eMMC using dd
# for use with LX2160A SoC family.
# It uses atf, u-boot, mc-utils, management-complex
#
# The disk layout used is:
#  - ------------- -------- ----- ------- -------- -------- ----- -------- ------ --------
# | | RCW+PBI+BL2 | u-boot | ddr | mc-fw | mc-dpl | mc-dpc | dtb | kernel | boot | rootfs |
#  - ------------- -------- ----- ------- -------- -------- ----- -------- ------ --------
# ^ ^             ^        ^     ^       ^        ^   ^    ^     ^        ^
# | |             |        |     |       |        |        |     |        |
# 0 4kiB          1MiB     8MiB  10MiB   13MiB    14MiB    15MiB 16MiB    64MiB
#
part bl2 --source rawcopy --sourceparams="file=${@ 'atf/bl2_auto.pbl' if os.path.exists(os.path.join(d.getVar('DEPLOY_DIR_IMAGE'), 'atf/bl2_auto.pbl')) else 'atf/bl2_sd.pbl' }" --no-table --offset 8s
part bl3 --source rawcopy --sourceparams="file=atf/fip_uboot.bin" --no-table --offset 2048s
part ddr --source rawcopy --sourceparams="file=ddr-phy/fip_ddr.bin" --no-table --offset 16384s
part mc-fw --source rawcopy --sourceparams="file=mc_app/mc.itb" --no-table --offset 20480s --fixed-size 2304k
part mc-dpl --source rawcopy --sourceparams="file=mc-utils/${MC_DPL}" --no-table --offset 26624s --fixed-size 1024k
part mc-dpc --source rawcopy --sourceparams="file=mc-utils/${MC_DPC}" --no-table --offset 28672s --fixed-size 1024k
part dtb --source rawcopy --sourceparams="file=${@os.path.basename(d.getVar('UBOOT_FDT_FILE') or 'error')}" --no-table --offset 30720s --fixed-size 1024k
part kernel --source rawcopy --sourceparams="file=Image.gz-initramfs-${MACHINE}.bin" --no-table --offset 32768s --fixed-size 48M
part /boot --source bootimg-partition --sourceparams="loader=u-boot" --fstype=vfat --label boot --active --use-uuid --offset 131072s --size 64
part / --source rootfs --fstype=ext4 --label rootfs --use-uuid --align 4096 --exclude-path boot/

bootloader --ptable msdos
